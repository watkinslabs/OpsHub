#!/bin/sh
set -eu
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-/tmp/opshub-xtask-target}"
cargo run --quiet --manifest-path automation/xtask/Cargo.toml -- audit-staged
cargo run --quiet --manifest-path automation/xtask/Cargo.toml -- validate-plan
cargo run --quiet --manifest-path automation/xtask/Cargo.toml -- validate-work
cargo run --quiet --manifest-path automation/xtask/Cargo.toml -- check-contracts
cargo run --quiet --manifest-path automation/xtask/Cargo.toml -- check-persistence
cargo run --quiet --manifest-path automation/xtask/Cargo.toml -- check-roles
